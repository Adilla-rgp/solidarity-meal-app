generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") 
}

model User {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  tipo      String?  // DOADOR ou BENEFICIARIO
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  DOADOR
  BENEFICIARIO
}